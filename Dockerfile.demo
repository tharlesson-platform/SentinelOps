FROM golang:1.27.1-alpine3.23@sha256:d9e2f2f07b10cc922da3e80e035c3058810b328d5aef82d2c63680967c5e2ec9 AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY demo ./demo
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -buildid=" -o /out/demo-api ./demo/api

FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk add --no-cache \
        ca-certificates=20260611-r0 \
        libcrypto3=3.5.8-r0 \
        libssl3=3.5.8-r0 \
        musl=1.2.6-r2 \
        musl-utils=1.2.6-r2 \
        tzdata=2026c-r0 \
        zlib=1.3.2-r0 \
    && addgroup -S -g 10002 demo \
    && adduser -S -D -H -u 10002 -G demo demo
COPY --from=build --chown=10002:10002 /out/demo-api /usr/local/bin/demo-api
USER 10002:10002
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/demo-api"]
