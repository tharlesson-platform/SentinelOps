{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelops.io/schemas/v1alpha1/synthetic-scenario.schema.json",
  "title": "SentinelOps SyntheticScenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "sentinelops.io/v1alpha1" },
    "kind": { "const": "SyntheticScenario" },
    "metadata": { "type": "object", "required": ["name"], "properties": { "name": { "$ref": "#/$defs/name" }, "labels": { "type": "object", "additionalProperties": { "type": "string" } } } },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["serviceRef", "environment", "type", "schedule", "steps"],
      "properties": {
        "serviceRef": { "$ref": "#/$defs/name" }, "environment": { "$ref": "#/$defs/name" },
        "type": { "enum": ["http", "browser", "k6", "dns", "tcp", "tls"] },
        "schedule": { "type": "object", "required": ["timezone"], "properties": { "cron": { "type": "string", "minLength": 5 }, "intervalSeconds": { "type": "integer", "minimum": 60 }, "timezone": { "type": "string", "default": "America/Sao_Paulo" }, "jitterSeconds": { "type": "integer", "minimum": 0, "maximum": 300 } }, "oneOf": [{ "required": ["cron"] }, { "required": ["intervalSeconds"] }] },
        "credentials": { "type": "object", "additionalProperties": { "type": "object", "required": ["secretRef"], "properties": { "secretRef": { "type": "string", "pattern": "^[a-zA-Z0-9_./-]+$" } } } },
        "steps": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "object", "required": ["action"], "properties": { "action": { "enum": ["goto", "request", "fill", "click", "select", "waitFor", "expectText", "expectUrl", "screenshot"] }, "url": { "type": "string", "format": "uri" }, "selector": { "type": "string", "maxLength": 500 }, "value": { "type": ["string", "number", "boolean"] }, "valueFrom": { "type": "string" } } } },
        "assertions": { "type": "array", "items": { "type": "object", "required": ["metric", "operator", "value"], "properties": { "metric": { "type": "string" }, "operator": { "enum": ["equal", "notEqual", "lessThan", "lessThanOrEqual", "greaterThan", "greaterThanOrEqual", "contains", "matches"] }, "value": {} } } },
        "artifacts": { "type": "object", "properties": { "screenshot": { "enum": ["always", "on-failure", "off"] }, "trace": { "enum": ["always", "on-first-retry", "on-failure", "off"] }, "video": { "enum": ["always", "on-failure", "off"] }, "har": { "enum": ["always", "on-failure", "off"] } } }
      }
    }
  },
  "$defs": { "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" } }
}

