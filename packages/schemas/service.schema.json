{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelops.io/schemas/v1alpha1/service.schema.json",
  "title": "SentinelOps Service",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "sentinelops.io/v1alpha1" },
    "kind": { "const": "Service" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "owner", "environments"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "tier": { "enum": ["1", "2", "3", "4"] },
        "owner": { "type": "object", "required": ["team"], "properties": { "team": { "$ref": "#/$defs/name" }, "email": { "type": "string", "format": "email" } } },
        "environments": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "timezone"], "properties": { "name": { "$ref": "#/$defs/name" }, "timezone": { "type": "string", "default": "America/Sao_Paulo" }, "endpoints": { "type": "array", "items": { "type": "object", "required": ["name", "url", "protocol"], "properties": { "name": { "$ref": "#/$defs/name" }, "url": { "type": "string", "format": "uri" }, "protocol": { "enum": ["http", "https", "grpc", "tcp"] } } } } } },
        "telemetry": { "type": "object", "properties": { "serviceName": { "$ref": "#/$defs/name" }, "metrics": { "type": "boolean" }, "logs": { "type": "boolean" }, "traces": { "type": "boolean" }, "profiles": { "type": "boolean" } } },
        "releasePolicyRef": { "$ref": "#/$defs/name" },
        "sloRefs": { "type": "array", "items": { "$ref": "#/$defs/name" } }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "$ref": "#/$defs/name" }, "labels": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 120 }, "maxProperties": 32 } } }
  }
}

