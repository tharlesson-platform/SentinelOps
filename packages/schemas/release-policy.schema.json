{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelops.io/schemas/v1alpha1/release-policy.schema.json",
  "title": "SentinelOps ReleasePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "sentinelops.io/v1alpha1" }, "kind": { "const": "ReleasePolicy" },
    "metadata": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" } } },
    "spec": { "type": "object", "required": ["stabilizationWindow", "observationWindow", "minimumSamples", "inconclusiveBehavior", "checks"], "properties": {
      "stabilizationWindow": { "$ref": "#/$defs/duration" }, "observationWindow": { "$ref": "#/$defs/duration" }, "baselineWindow": { "$ref": "#/$defs/duration" },
      "minimumSamples": { "type": "integer", "minimum": 1 }, "inconclusiveBehavior": { "enum": ["block", "warn", "pass"] },
      "checks": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "source", "required", "threshold"], "properties": { "name": { "type": "string" }, "source": { "enum": ["metrics", "logs", "traces", "profiles", "infrastructure", "synthetic", "slo"] }, "required": { "type": "boolean" }, "threshold": { "type": "object", "required": ["operator", "value"], "properties": { "operator": { "enum": ["equal", "lessThan", "lessThanOrEqual", "greaterThan", "greaterThanOrEqual"] }, "value": {} } }, "regression": { "type": "object", "properties": { "maxRelativeIncrease": { "type": "number", "minimum": 0 } } } } } }
    } }
  },
  "$defs": { "duration": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" } }
}

