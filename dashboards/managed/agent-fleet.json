      "id": 4,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{job=\"linux-system\",deployment_environment=~\"$environment\",host_name=~\"$host\"} |~ \"(?i)alloy|cadvisor|beyla|sentinelops\"",
          "refId": "A",
          "maxLines": 200
        }
      ],
      "description": "Logs dos collectors. Exibe apenas telemetria real no escopo dos filtros; ausência é apresentada como Sem dados.",
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
