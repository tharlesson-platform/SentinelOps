{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Deployments",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "SentinelOps",
      "type": "link",
      "url": "http://localhost:3000"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Containers observados",
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(container_last_seen{deployment_environment=~\"$environment\",instance=~\"$host\",name=~\"$container\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU por container",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (instance, name) (rate(container_cpu_usage_seconds_total{deployment_environment=~\"$environment\",instance=~\"$host\",name=~\"$container\"}[5m])) * 100",
          "refId": "A",
          "legendFormat": "{{instance}} · {{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memória por container",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (instance, name) (container_memory_working_set_bytes{deployment_environment=~\"$environment\",instance=~\"$host\",name=~\"$container\"})",
          "refId": "A",
          "legendFormat": "{{instance}} · {{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rede por container",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (instance, name) (rate(container_network_receive_bytes_total{deployment_environment=~\"$environment\",instance=~\"$host\",name=~\"$container\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}} · {{name}} RX"
        },
        {
          "expr": "sum by (instance, name) (rate(container_network_transmit_bytes_total{deployment_environment=~\"$environment\",instance=~\"$host\",name=~\"$container\"}[5m]))",
          "refId": "B",
          "legendFormat": "{{instance}} · {{name}} TX"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "I/O de filesystem",
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (instance, name) (rate(container_fs_reads_bytes_total{deployment_environment=~\"$environment\",instance=~\"$host\",name=~\"$container\"}[5m]) + rate(container_fs_writes_bytes_total{deployment_environment=~\"$environment\",instance=~\"$host\",name=~\"$container\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}} · {{name}}"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": [
    "sentinelops",
    "managed",
    "docker"
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"linux-node\"}, deployment_environment)",
          "refId": "var-environment"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info{deployment_environment=~\"$environment\"}, instance)",
          "refId": "var-host"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "container",
        "label": "Aplicação / container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{deployment_environment=~\"$environment\",instance=~\"$host\",name!=\"\"}, name)",
          "refId": "var-container"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Docker Containers",
  "uid": "sentinel-docker-overview",
  "version": 3,
  "description": "Métricas Docker filtráveis por ambiente, host e aplicação/container."
}
