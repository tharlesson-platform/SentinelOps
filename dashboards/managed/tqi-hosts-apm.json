{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Deployments",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "text",
      "title": "Cobertura centralizada",
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "### TQI — hosts e aplicações\n\nEste painel consolida os três hosts de produção: **tqi-platform**, **tqi-platform-edge** e **easy-vm**. A infraestrutura e os logs já são coletados. Os painéis RED e traces passam a exibir dados por host assim que cada processo da aplicação publicar OpenTelemetry no coletor local (`127.0.0.1:4318` para processos no host ou `host.docker.internal:4318` para contêineres)."
      }
    },
    {
      "type": "stat",
      "title": "Hosts com coleta",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(up{job=\"linux-node\",deployment_environment=~\"$environment\",instance=~\"$host\"} == 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "CPU utilizada",
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 - avg(rate(node_cpu_seconds_total{deployment_environment=~\"$environment\",instance=~\"$host\",mode=\"idle\"}[5m])) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Memória utilizada",
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{deployment_environment=~\"$environment\",instance=~\"$host\"} / node_memory_MemTotal_bytes{deployment_environment=~\"$environment\",instance=~\"$host\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Maior uso de filesystem",
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{deployment_environment=~\"$environment\",instance=~\"$host\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{deployment_environment=~\"$environment\",instance=~\"$host\",fstype!~\"tmpfs|overlay\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Logs com erro (15 min)",
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"docker-container\",deployment_environment=~\"$environment\",host_name=~\"$host\",filename=~\".*/$container_id/.*\"} |~ \"(?i)error|exception|fatal\" [15m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Serviços APM com tráfego",
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(sum by (job) ((rate(http_server_request_duration_seconds_count{job=~\"$host/(.*/)?$application\",http_route=~\"$route\"}[5m]) or (rate(http_server_request_duration_seconds_count{job=~\"(.*/)?$application\",http_route=~\"$route\"}[5m]) * on (job, instance) group_left (host_name) max by (job, instance, host_name) (target_info{host_name=~\"$host\",telemetry_sdk_name=\"beyla\"})))))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "CPU por host",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{deployment_environment=~\"$environment\",instance=~\"$host\",mode=\"idle\"}[5m])) * 100",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Memória por host",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{deployment_environment=~\"$environment\",instance=~\"$host\"} / node_memory_MemTotal_bytes{deployment_environment=~\"$environment\",instance=~\"$host\"})",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Rede — recebimento e transmissão",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{deployment_environment=~\"$environment\",instance=~\"$host\",device!=\"lo\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}} RX"
        },
        {
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{deployment_environment=~\"$environment\",instance=~\"$host\",device!=\"lo\"}[5m]))",
          "refId": "B",
          "legendFormat": "{{instance}} TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "APM RED — requisições por segundo",
      "description": "Métricas OpenTelemetry nativas e eBPF por host e serviço.",
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (job, http_request_method, http_route) ((rate(http_server_request_duration_seconds_count{job=~\"$host/(.*/)?$application\",http_route=~\"$route\"}[5m]) or (rate(http_server_request_duration_seconds_count{job=~\"(.*/)?$application\",http_route=~\"$route\"}[5m]) * on (job, instance) group_left (host_name) max by (job, instance, host_name) (target_info{host_name=~\"$host\",telemetry_sdk_name=\"beyla\"}))))",
          "refId": "A",
          "legendFormat": "{{job}} · {{http_request_method}} {{http_route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "APM RED — latência p95",
      "description": "Métricas OpenTelemetry nativas e eBPF por host e serviço.",
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job, http_route) ((rate(http_server_request_duration_seconds_bucket{job=~\"$host/(.*/)?$application\",http_route=~\"$route\"}[5m]) or (rate(http_server_request_duration_seconds_bucket{job=~\"(.*/)?$application\",http_route=~\"$route\"}[5m]) * on (job, instance) group_left (host_name) max by (job, instance, host_name) (target_info{host_name=~\"$host\",telemetry_sdk_name=\"beyla\"})))))",
          "refId": "A",
          "legendFormat": "{{job}} · {{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "APM RED — taxa de erros 5xx",
      "description": "Métricas OpenTelemetry nativas e eBPF por host e serviço.",
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * sum by (job) ((rate(http_server_request_duration_seconds_count{job=~\"$host/(.*/)?$application\",http_route=~\"$route\",http_response_status_code=~\"5..\"}[5m]) or (rate(http_server_request_duration_seconds_count{job=~\"(.*/)?$application\",http_route=~\"$route\",http_response_status_code=~\"5..\"}[5m]) * on (job, instance) group_left (host_name) max by (job, instance, host_name) (target_info{host_name=~\"$host\",telemetry_sdk_name=\"beyla\"})))) / clamp_min(sum by (job) ((rate(http_server_request_duration_seconds_count{job=~\"$host/(.*/)?$application\",http_route=~\"$route\"}[5m]) or (rate(http_server_request_duration_seconds_count{job=~\"(.*/)?$application\",http_route=~\"$route\"}[5m]) * on (job, instance) group_left (host_name) max by (job, instance, host_name) (target_info{host_name=~\"$host\",telemetry_sdk_name=\"beyla\"})))), 0.000001)",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "traces",
      "title": "APM — traces distribuídos",
      "description": "Traces OpenTelemetry por namespace do host.",
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "query": "{ resource.service.namespace =~ \"$host\" && resource.service.name =~ \"$application\" && span.http.route =~ \"$route\" }",
          "queryType": "traceql",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Logs das aplicações e do sistema",
      "id": 15,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{job=\"docker-container\",deployment_environment=~\"$environment\",host_name=~\"$host\",filename=~\".*/$container_id/.*\"}",
          "refId": "A"
        },
        {
          "expr": "{service_name=~\"$application\"}",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "sentinelops",
    "tqi",
    "production",
    "hosts",
    "apm"
  ],
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Aplicação",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, job)",
          "refId": "var-application"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "regex": "/([^\\/\"]+)$/"
      },
      {
        "name": "route",
        "label": "Rota ativa (top 200)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(topk(200, sum by (http_route) (rate(http_server_request_duration_seconds_count{job=~\"(.*/)?$application\",http_route!=\"\"}[15m]))))",
          "refId": "var-route"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "regex": "/http_route=\"([^\"]+)\"/"
      },
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"linux-node\"}, deployment_environment)",
          "refId": "var-environment"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info{deployment_environment=~\"$environment\"}, instance)",
          "refId": "var-host"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "container",
        "label": "Aplicação / container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{deployment_environment=~\"$environment\",instance=~\"$host\",name!=\"\"}, name)",
          "refId": "var-container"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "container_id",
        "label": "Container ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{deployment_environment=~\"$environment\",instance=~\"$host\",name=~\"$container\"}, id)",
          "refId": "var-container_id"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 2,
        "regex": "/.*\\/([a-f0-9]{12,64})$/"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "TQI — Hosts e APM de Aplicações",
  "uid": "sentinel-tqi-hosts-apm",
  "version": 3,
  "description": "Visão TQI filtrável por aplicação, rota, ambiente, host e aplicação/container Docker."
}
