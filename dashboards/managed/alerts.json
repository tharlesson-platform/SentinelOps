        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (alertname) (ALERTS{alertstate=\"firing\",severity=~\"$severity\",alertname=~\"$alertname\"}))",
          "refId": "A",
          "legendFormat": "{{alertname}}",
          "maxDataPoints": 600
        }
      ],
      "description": "Top alertas ativos. Exibe apenas telemetria real no escopo dos filtros; ausência é apresentada como Sem dados.",
      "fieldConfig": {
