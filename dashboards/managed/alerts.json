      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (severity) (ALERTS{alertstate=\"firing\",severity=~\"$severity\",alertname=~\"$alertname\"})",
          "refId": "A",
          "legendFormat": "{{severity}}",
          "maxDataPoints": 600
        }
      ],
      "description": "Alertas por severidade. Exibe apenas telemetria real no escopo dos filtros; ausência é apresentada como Sem dados.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
