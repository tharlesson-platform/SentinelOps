  "refresh": "15s",
  "schemaVersion": 42,
  "tags": [
    "alerts",
    "managed",
    "noc-ready",
    "sentinelops"
  ],
  "templating": {
    "list": [
      {
        "name": "severity",
        "label": "Severidade",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ALERTS, severity)",
          "refId": "var-severity"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "alertname",
        "label": "Alerta",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ALERTS{severity=~\"$severity\"}, alertname)",
          "refId": "var-alertname"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"linux-node\"}, deployment_environment)",
          "refId": "var-environment"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "production",
          "value": "production"
        },
        "hide": 0
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info{deployment_environment=~\"$environment\"}, instance)",
          "refId": "var-host"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "container",
        "label": "Container Docker",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{deployment_environment=~\"$environment\",instance=~\"$host\",name!=\"\"}, name)",
          "refId": "var-container"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "container_id",
        "label": "Container ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{deployment_environment=~\"$environment\",instance=~\"$host\",name=~\"$container\"}, id)",
          "refId": "var-container_id"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 2,
        "regex": "/.*(?:\\/|docker-)([a-f0-9]{64})(?:\\.scope)?$/"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Alerts",
  "uid": "sentinel-alerts",
  "version": 3,
  "description": "Fila de alertas firing por severidade e nome, com logs de aplicação para correlação."
}
