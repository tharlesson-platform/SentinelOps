{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Deployments",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "SentinelOps",
      "type": "link",
      "url": "http://localhost:3000"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Frontends observados em Docker",
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(container_last_seen{name=~\".*(frontend|web).*\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU dos frontends",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".*(frontend|web).*\"}[5m]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memória dos frontends",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (name) (container_memory_working_set_bytes{name=~\".*(frontend|web).*\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Logs reais de frontend",
      "id": 4,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{job=\"docker-container\",host_name=\"tqi-platform\"} |= \"frontend\"",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "RUM/Web Vitals instrumentado",
      "id": 5,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(web_vitals_lcp_seconds)",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": [
    "sentinelops",
    "managed",
    "frontend-observability"
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "custom",
        "query": "production",
        "current": {
          "text": "production",
          "value": "production"
        }
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Frontend Observability",
  "uid": "sentinel-frontend-observability",
  "version": 2,
  "description": "Runtime real dos contêineres frontend; RUM/Web Vitals requer instrumentação de browser em artefato futuro."
}
