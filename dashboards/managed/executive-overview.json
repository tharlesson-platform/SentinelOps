  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"linux-node\"}, deployment_environment)",
          "refId": "var-environment"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "production",
          "value": "production"
        },
        "hide": 0
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info{deployment_environment=~\"$environment\"}, instance)",
          "refId": "var-host"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Executive Overview",
  "uid": "sentinel-executive-overview",
  "version": 3,
  "description": "Resumo executivo de disponibilidade, saturação, alertas e cobertura APM com dados reais."
}
