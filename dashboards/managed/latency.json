    {
      "type": "logs",
      "title": "Logs da aplicação nos últimos 5 minutos",
      "id": 4,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"docker-container\",filename=~\".*/(${container_id:regex})/.*\",host_name=~\"$host\",deployment_environment=~\"$environment\"} [5m]))",
          "refId": "A",
          "maxLines": 200
        }
      ],
      "description": "Logs da aplicação nos últimos 5 minutos. Exibe apenas telemetria real no escopo dos filtros; ausência é apresentada como Sem dados.",
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "type": "traces",
      "title": "Traces acima de 1 segundo",
      "id": 5,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "query": "{ resource.service.name =~ \"$application\" && duration > 1s }",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "description": "Traces acima de 1 segundo. Exibe apenas telemetria real no escopo dos filtros; ausência é apresentada como Sem dados."
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": [
    "latency",
    "managed",
    "noc-ready",
    "sentinelops"
  ],
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Aplicação APM (service.name)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, job)",
          "refId": "var-application"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "route",
        "label": "Rota APM (regex; padrão: todas)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "selected": true,
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"linux-node\"}, deployment_environment)",
          "refId": "var-environment"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "production",
          "value": "production"
        },
        "hide": 0
      },
      {
        "name": "host",
        "label": "Host (logs/containers)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info{deployment_environment=~\"$environment\"}, instance)",
          "refId": "var-host"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "container",
        "label": "Container Docker",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{deployment_environment=~\"$environment\",instance=~\"$host\",name!=\"\"}, name)",
          "refId": "var-container"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "container_id",
        "label": "Container ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{deployment_environment=~\"$environment\",instance=~\"$host\",name=~\"$container\"}, id)",
          "refId": "var-container_id"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 2,
        "regex": "/.*(?:\\/|docker-)([a-f0-9]{64})(?:\\.scope)?$/"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Latency",
  "uid": "sentinel-latency",
  "version": 3,
  "description": "Telemetria real com filtros encadeados de aplicação, rota, ambiente, host e container."
}
