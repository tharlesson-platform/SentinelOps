{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Deployments",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "SentinelOps",
      "type": "link",
      "url": "http://localhost:3000"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Hosts Linux ativos",
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(up{job=\"linux-node\"} == 1)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU por host",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{job=\"linux-node\",mode=\"idle\"}[5m])) * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memória utilizada por host",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"linux-node\"} / node_memory_MemTotal_bytes{job=\"linux-node\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Logs reais de aplicações",
      "id": 4,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{job=\"docker-container\",host_name=\"tqi-platform\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Contêineres observados",
      "id": 5,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(container_last_seen{name!=\"\"})",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": [
    "sentinelops",
    "managed",
    "noc-overview"
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "custom",
        "query": "production",
        "current": {
          "text": "production",
          "value": "production"
        }
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "NOC Overview",
  "uid": "sentinel-noc-overview",
  "version": 2,
  "description": "Métricas reais da frota Linux recebidas pelos coletores SentinelOps."
}
