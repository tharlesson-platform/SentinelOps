{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Deployments",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "SentinelOps",
      "type": "link",
      "url": "http://localhost:3000"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Eventos no período",
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=~\"$log_source\",deployment_environment=~\"$environment\",host_name=~\"$host\",filename=~\".*/$container_id/.*\",stream=~\"$stream\"} |~ \"$search\" [$__range]))",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({job=~\"$log_source\",job!=\"docker-container\",deployment_environment=~\"$environment\",host_name=~\"$host\"} |~ \"$search\" [$__range]))",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Volume de logs por aplicação/container",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (host_name, filename) (count_over_time({job=~\"$log_source\",deployment_environment=~\"$environment\",host_name=~\"$host\",filename=~\".*/$container_id/.*\",stream=~\"$stream\"} |~ \"$search\" [$__interval]))",
          "refId": "A",
          "legendFormat": "{{host_name}} · {{filename}}"
        },
        {
          "expr": "sum by (job, host_name) (count_over_time({job=~\"$log_source\",job!=\"docker-container\",deployment_environment=~\"$environment\",host_name=~\"$host\"} |~ \"$search\" [$__interval]))",
          "refId": "B",
          "legendFormat": "{{job}} · {{host_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Erros por intervalo",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=~\"$log_source\",deployment_environment=~\"$environment\",host_name=~\"$host\",filename=~\".*/$container_id/.*\",stream=~\"$stream\"} |~ \"$search\" |~ \"(?i)error|exception|fatal\" [$__interval]))",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({job=~\"$log_source\",job!=\"docker-container\",deployment_environment=~\"$environment\",host_name=~\"$host\"} |~ \"$search\" |~ \"(?i)error|exception|fatal\" [$__interval]))",
          "refId": "B"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Logs filtrados",
      "id": 4,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{job=~\"$log_source\",deployment_environment=~\"$environment\",host_name=~\"$host\",filename=~\".*/$container_id/.*\",stream=~\"$stream\"} |~ \"$search\"",
          "refId": "A"
        },
        {
          "expr": "{job=~\"$log_source\",job!=\"docker-container\",deployment_environment=~\"$environment\",host_name=~\"$host\"} |~ \"$search\"",
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Erros no período",
      "id": 5,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=~\"$log_source\",deployment_environment=~\"$environment\",host_name=~\"$host\",filename=~\".*/$container_id/.*\",stream=~\"$stream\"} |~ \"$search\" |~ \"(?i)error|exception|fatal\" [$__range]))",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({job=~\"$log_source\",job!=\"docker-container\",deployment_environment=~\"$environment\",host_name=~\"$host\"} |~ \"$search\" |~ \"(?i)error|exception|fatal\" [$__range]))",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": [
    "sentinelops",
    "managed",
    "logs"
  ],
  "templating": {
    "list": [
      {
        "name": "log_source",
        "label": "Fonte de logs",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "query": "label_values({job=~\".+\"}, job)",
          "refId": "var-log_source"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "docker-container",
          "value": "docker-container"
        },
        "hide": 0
      },
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"linux-node\"}, deployment_environment)",
          "refId": "var-environment"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info{deployment_environment=~\"$environment\"}, instance)",
          "refId": "var-host"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "container",
        "label": "Aplicação / container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{deployment_environment=~\"$environment\",instance=~\"$host\",name!=\"\"}, name)",
          "refId": "var-container"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "container_id",
        "label": "Container ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{deployment_environment=~\"$environment\",instance=~\"$host\",name=~\"$container\"}, id)",
          "refId": "var-container_id"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 2,
        "regex": "/.*\\/([a-f0-9]{12,64})$/"
      },
      {
        "name": "stream",
        "label": "Stream",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "query": "label_values({job=\"docker-container\",host_name=~\"$host\",filename=~\".*/$container_id/.*\"}, stream)",
          "refId": "var-stream"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "search",
        "label": "Buscar no conteúdo (regex)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "selected": true,
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Logs",
  "uid": "sentinel-logs",
  "version": 3,
  "description": "Logs pesquisáveis por fonte, aplicação/container Docker, ambiente, host, stream e conteúdo."
}
