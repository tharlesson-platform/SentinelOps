{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Deployments",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "SentinelOps",
      "type": "link",
      "url": "http://localhost:3000"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Eventos no período",
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=~\"$log_source\",deployment_environment=~\"$environment\",host_name=~\"$host\",filename=~\".*/(${container_id:regex})/.*\",stream=~\"$stream\"} |~ \"$search\" [$__range]))",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({job=~\"$log_source\",job!=\"docker-container\",deployment_environment=~\"$environment\",host_name=~\"$host\"} |~ \"$search\" [$__range]))",
          "refId": "B"
        }
      ],
      "description": "Eventos no período. Exibe apenas telemetria real no escopo dos filtros; ausência é apresentada como Sem dados.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false
      }
    },
    {
      "type": "timeseries",
      "title": "Volume de logs por aplicação/container",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (host_name) (count_over_time({job=~\"$log_source\",deployment_environment=~\"$environment\",host_name=~\"$host\",filename=~\".*/(${container_id:regex})/.*\",stream=~\"$stream\"} |~ \"$search\" [$__interval]))",
          "refId": "A",
          "legendFormat": "{{host_name}}",
          "maxDataPoints": 600
        },
        {
          "expr": "sum by (job, host_name) (count_over_time({job=~\"$log_source\",job!=\"docker-container\",deployment_environment=~\"$environment\",host_name=~\"$host\"} |~ \"$search\" [$__interval]))",
          "refId": "B",
          "legendFormat": "{{job}} · {{host_name}}",
          "maxDataPoints": 600
        }
      ],
      "description": "Volume de logs por aplicação/container. Exibe apenas telemetria real no escopo dos filtros; ausência é apresentada como Sem dados.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Possíveis erros por intervalo (regex)",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=~\"$log_source\",deployment_environment=~\"$environment\",host_name=~\"$host\",filename=~\".*/(${container_id:regex})/.*\",stream=~\"$stream\"} |~ \"$search\" |~ \"(?i)error|exception|fatal\" [$__interval]))",
          "refId": "A",
          "maxDataPoints": 600
        },
        {
          "expr": "sum(count_over_time({job=~\"$log_source\",job!=\"docker-container\",deployment_environment=~\"$environment\",host_name=~\"$host\"} |~ \"$search\" |~ \"(?i)error|exception|fatal\" [$__interval]))",
          "refId": "B",
          "maxDataPoints": 600
        }
      ],
      "description": "Triagem textual por error/exception/fatal; stack traces podem elevar a contagem.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      }
    },
    {
      "type": "logs",
      "title": "Logs filtrados (máximo 200 linhas)",
      "id": 4,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{job=~\"$log_source\",deployment_environment=~\"$environment\",host_name=~\"$host\",filename=~\".*/(${container_id:regex})/.*\",stream=~\"$stream\"} |~ \"$search\"",
          "refId": "A",
          "maxLines": 200
        },
        {
          "expr": "{job=~\"$log_source\",job!=\"docker-container\",deployment_environment=~\"$environment\",host_name=~\"$host\"} |~ \"$search\"",
          "refId": "B",
          "maxLines": 200
        }
      ],
      "description": "Conteúdo bruto pode conter dados pessoais; aplicar mascaramento no collector antes da ingestão.",
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "type": "stat",
      "title": "Possíveis erros no período (regex)",
      "id": 5,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=~\"$log_source\",deployment_environment=~\"$environment\",host_name=~\"$host\",filename=~\".*/(${container_id:regex})/.*\",stream=~\"$stream\"} |~ \"$search\" |~ \"(?i)error|exception|fatal\" [$__range]))",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({job=~\"$log_source\",job!=\"docker-container\",deployment_environment=~\"$environment\",host_name=~\"$host\"} |~ \"$search\" |~ \"(?i)error|exception|fatal\" [$__range]))",
          "refId": "B"
        }
      ],
      "description": "Fallback por regex; não equivale a uma contagem estruturada por severity.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false
      }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": [
    "logs",
    "managed",
    "noc-ready",
    "sentinelops"
  ],
  "templating": {
    "list": [
      {
        "name": "log_source",
        "label": "Fonte de logs",
        "type": "custom",
        "query": "Aplicações Docker : docker-container,Sistema Linux : linux-system",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "selected": true,
          "text": "Aplicações Docker",
          "value": "docker-container"
        },
        "options": []
      },
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"linux-node\"}, deployment_environment)",
          "refId": "var-environment"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "production",
          "value": "production"
        },
        "hide": 0
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info{deployment_environment=~\"$environment\"}, instance)",
          "refId": "var-host"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "container",
        "label": "Container Docker",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{deployment_environment=~\"$environment\",instance=~\"$host\",name!=\"\"}, name)",
          "refId": "var-container"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "container_id",
        "label": "Container ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{deployment_environment=~\"$environment\",instance=~\"$host\",name=~\"$container\"}, id)",
          "refId": "var-container_id"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 2,
        "regex": "/.*(?:\\/|docker-)([a-f0-9]{64})(?:\\.scope)?$/"
      },
      {
        "name": "stream",
        "label": "Stream",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "query": "label_values({job=\"docker-container\",host_name=~\"$host\",filename=~\".*/(${container_id:regex})/.*\"}, stream)",
          "refId": "var-stream"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "search",
        "label": "Buscar no conteúdo (regex)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "selected": true,
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Logs",
  "uid": "sentinel-logs",
  "version": 3,
  "description": "Logs pesquisáveis por fonte, container Docker, ambiente, host, stream e conteúdo. A detecção de erro é fallback por regex, não severidade normalizada; dados pessoais exigem redaction upstream."
}
