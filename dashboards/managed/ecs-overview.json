{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Deployments",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "SentinelOps",
      "type": "link",
      "url": "http://localhost:3000"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Collector ECS Overview",
      "description": "1 = disponível; 0 = indisponível; Sem dados = integração ainda não cadastrada.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(up{job=\"sentinel-ecs\",instance=~\"$collector_instance\"})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "text",
      "title": "Integração pendente",
      "description": "Orientação operacional; não é dado de monitoramento.",
      "options": {
        "mode": "markdown",
        "content": "### Sem fonte real configurada\n\nEsta dashboard não reutiliza métricas, logs ou traces de outro domínio. Conclua o onboarding do collector e valide identidade, freshness e alertas antes de habilitar o uso pelo NOC."
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 5
      }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": [
    "ecs-overview",
    "managed",
    "noc-ready",
    "sentinelops"
  ],
  "templating": {
    "list": [
      {
        "name": "collector_instance",
        "label": "Instância do collector",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"sentinel-ecs\"}, instance)",
          "refId": "var-collector_instance"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "ECS Overview",
  "uid": "sentinel-ecs-overview",
  "version": 3,
  "description": "Status de onboarding de ECS Overview. Não apresenta KPIs substitutos: sem collector real, exibe Sem dados."
}
