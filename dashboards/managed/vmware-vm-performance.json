  "templating": {
    "list": [
      {
        "name": "endpoint",
        "label": "Endpoint VMware",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(sentinelops_vmware_vm_power_state, endpoint)",
          "refId": "var-endpoint"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "vm",
        "label": "Máquina virtual",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(sentinelops_vmware_vm_power_state{endpoint=~\"$endpoint\"}, vm_name)",
          "refId": "var-vm"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "datastore",
        "label": "Datastore",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(sentinelops_vmware_datastore_capacity_bytes{endpoint=~\"$endpoint\"}, datastore)",
          "refId": "var-datastore"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "VMware Virtual Machine Performance",
  "uid": "sentinel-vmware-vm-performance",
