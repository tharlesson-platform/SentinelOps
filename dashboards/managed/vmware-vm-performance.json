{
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "Coleta de desempenho VMware",
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(sentinelops_vmware_performance_scrape_success{endpoint=~\"$endpoint\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "VMs ligadas",
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(sentinelops_vmware_vm_power_state{endpoint=~\"$endpoint\",vm_name=~\"$vm\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "VMware Tools em execução",
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(sentinelops_vmware_vm_tools_running{endpoint=~\"$endpoint\",vm_name=~\"$vm\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Datastore livre",
      "id": 4,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(sentinelops_vmware_datastore_free_bytes{endpoint=~\"$endpoint\",datastore=~\"$datastore\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Rede das VMs",
      "description": "Tráfego observado pelo hypervisor; não requer agente no sistema convidado.",
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sentinelops_vmware_vm_network_receive_bytes_per_second{endpoint=~\"$endpoint\",vm_name=~\"$vm\"}",
          "refId": "A",
          "legendFormat": "{{vm_name}} RX"
        },
        {
          "expr": "sentinelops_vmware_vm_network_transmit_bytes_per_second{endpoint=~\"$endpoint\",vm_name=~\"$vm\"}",
          "refId": "B",
          "legendFormat": "{{vm_name}} TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput de disco das VMs",
      "description": "Leitura e escrita vistas pelo ESXi.",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sentinelops_vmware_vm_disk_read_bytes_per_second{endpoint=~\"$endpoint\",vm_name=~\"$vm\"}",
          "refId": "A",
          "legendFormat": "{{vm_name}} leitura"
        },
        {
          "expr": "sentinelops_vmware_vm_disk_write_bytes_per_second{endpoint=~\"$endpoint\",vm_name=~\"$vm\"}",
          "refId": "B",
          "legendFormat": "{{vm_name}} escrita"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "IOPS de disco das VMs",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sentinelops_vmware_vm_disk_read_iops{endpoint=~\"$endpoint\",vm_name=~\"$vm\"}",
          "refId": "A",
          "legendFormat": "{{vm_name}} leitura"
        },
        {
          "expr": "sentinelops_vmware_vm_disk_write_iops{endpoint=~\"$endpoint\",vm_name=~\"$vm\"}",
          "refId": "B",
          "legendFormat": "{{vm_name}} escrita"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "iops"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Latência de disco das VMs",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sentinelops_vmware_vm_disk_read_latency_milliseconds{endpoint=~\"$endpoint\",vm_name=~\"$vm\"}",
          "refId": "A",
          "legendFormat": "{{vm_name}} leitura"
        },
        {
          "expr": "sentinelops_vmware_vm_disk_write_latency_milliseconds{endpoint=~\"$endpoint\",vm_name=~\"$vm\"}",
          "refId": "B",
          "legendFormat": "{{vm_name}} escrita"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "CPU das VMs",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sentinelops_vmware_vm_cpu_usage_mhz{endpoint=~\"$endpoint\",vm_name=~\"$vm\"}",
          "refId": "A",
          "legendFormat": "{{vm_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mhz"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memória das VMs",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sentinelops_vmware_vm_memory_usage_bytes{endpoint=~\"$endpoint\",vm_name=~\"$vm\"}",
          "refId": "A",
          "legendFormat": "{{vm_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "sentinelops",
    "managed",
    "vmware",
    "vm-performance"
  ],
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "label": "Endpoint VMware",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(sentinelops_vmware_vm_power_state, endpoint)",
          "refId": "var-endpoint"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "vm",
        "label": "Máquina virtual",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(sentinelops_vmware_vm_power_state{endpoint=~\"$endpoint\"}, vm_name)",
          "refId": "var-vm"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "datastore",
        "label": "Datastore",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(sentinelops_vmware_datastore_capacity_bytes{endpoint=~\"$endpoint\"}, datastore)",
          "refId": "var-datastore"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "VMware Virtual Machine Performance",
  "uid": "sentinel-vmware-vm-performance",
  "version": 3
}
