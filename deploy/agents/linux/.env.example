SENTINEL_HOST_NAME=linux-host
SENTINEL_ENVIRONMENT=development
SENTINEL_TEAM=platform
SENTINEL_LOCATION=on-premises
SENTINEL_METRICS_ENDPOINT=https://sentinel.example.invalid/prometheus/api/v1/write
SENTINEL_LOGS_ENDPOINT=https://sentinel.example.invalid/loki/loki/api/v1/push
SENTINEL_OTLP_ENDPOINT=https://sentinel.example.invalid/otlp
SENTINEL_TLS_SERVER_NAME=sentinel.example.invalid
SENTINEL_COLLECTOR_ADMIN_PORT=12345
SENTINEL_COLLECTOR_OTLP_GRPC_PORT=4317
SENTINEL_COLLECTOR_OTLP_HTTP_PORT=4318
# Use o IP do gateway da bridge Docker (normalmente 172.17.0.1) somente
# quando aplicações em contêiner precisarem enviar OTLP ao Alloy local.
# Fora desse caso, mantenha 127.0.0.2.
SENTINEL_COLLECTOR_DOCKER_BRIDGE_ADDRESS=127.0.0.2
SENTINEL_COLLECT_CONTAINERS=false
SENTINEL_COLLECT_CADVISOR=false
SENTINEL_COLLECT_BEYLA=false
SENTINEL_LOG_READ_GID=4
SENTINEL_ALLOY_IMAGE=sentinelops-alloy:1.18.1-patched.2
# Imagem fixada por digest; substitua somente após validação de compatibilidade
# com o kernel e revisão de segurança.
SENTINEL_BEYLA_IMAGE=grafana/beyla:3.15.0@sha256:8ff0dcb4aa31fab39ba0b40715d0c0441d4522b43fb7886768ec280cc401dd69
SENTINEL_DOCKER_LOG_ROOT=/var/lib/docker/containers
