prometheus.exporter.unix "linux_node" {
  rootfs_path = "/host/root"
  procfs_path = "/host/proc"
  sysfs_path = "/host/sys"
  enable_collectors = ["processes", "tcpstat"]
  disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs"]
}

discovery.relabel "linux_node" {
  targets = prometheus.exporter.unix.linux_node.targets
  rule {
    target_label = "job"
    replacement = "linux-node"
  }
  rule {
    target_label = "instance"
    replacement = sys.env("SENTINEL_HOST_NAME")
  }
  // Explicit shared identity for metrics, Docker logs and host navigation.
  rule {
    target_label = "host_name"
    replacement = sys.env("SENTINEL_HOST_NAME")
  }
  rule {
    target_label = "deployment_environment"
    replacement = sys.env("SENTINEL_ENVIRONMENT")
  }
  rule {
    target_label = "team"
    replacement = sys.env("SENTINEL_TEAM")
  }
  rule {
    target_label = "location"
    replacement = sys.env("SENTINEL_LOCATION")
  }
}

prometheus.scrape "linux_node" {
  targets = discovery.relabel.linux_node.output
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.sentinel.receiver]
}

prometheus.remote_write "sentinel" {
  endpoint {
    url = sys.env("SENTINEL_METRICS_ENDPOINT")
    send_native_histograms = true
    tls_config {
      ca_file = "/etc/sentinelops/certs/ca.crt"
      cert_file = "/etc/sentinelops/certs/client.crt"
      key_file = "/etc/sentinelops/certs/client.key"
      server_name = sys.env("SENTINEL_TLS_SERVER_NAME")
      min_version = "TLS12"
    }
  }
  wal {
    truncate_frequency = "2h"
    min_keepalive_time = "5m"
    max_keepalive_time = "8h"
  }
}

local.file_match "system_logs" {
  path_targets = [{
    "__path__" = "/host/var/log/*.log",
    "job" = "linux-system",
    "host_name" = sys.env("SENTINEL_HOST_NAME"),
    "deployment_environment" = sys.env("SENTINEL_ENVIRONMENT"),
    "team" = sys.env("SENTINEL_TEAM"),
    "location" = sys.env("SENTINEL_LOCATION"),
  }]
}

loki.source.file "system_logs" {
  targets = local.file_match.system_logs.targets
  forward_to = [loki.process.system_logs.receiver]
}

loki.process "system_logs" {
  stage.drop {
    expression = "(?i)(authorization|cookie|password|passwd|secret|token)="
    drop_counter_reason = "possible_secret"
  }
  forward_to = [loki.write.sentinel.receiver]
}

loki.write "sentinel" {
  endpoint {
    url = sys.env("SENTINEL_LOGS_ENDPOINT")
    tls_config {
      ca_file = "/etc/sentinelops/certs/ca.crt"
      cert_file = "/etc/sentinelops/certs/client.crt"
      key_file = "/etc/sentinelops/certs/client.key"
      server_name = sys.env("SENTINEL_TLS_SERVER_NAME")
      min_version = "TLS12"
    }
  }
  external_labels = {
    source = "sentinelops-linux-collector",
  }
}

otelcol.receiver.otlp "applications" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    metrics = [otelcol.processor.transform.collector_identity.input]
    logs = [otelcol.processor.transform.collector_identity.input]
    traces = [otelcol.processor.transform.collector_identity.input]
  }
}

// A identidade do host é determinada pelo collector local autorizado.
otelcol.processor.transform "collector_identity" {
  error_mode = "ignore"
  metric_statements {
    context = "resource"
    statements = [
      string.format("set(attributes[\"host.name\"], %q)", sys.env("SENTINEL_HOST_NAME")),
      string.format("set(attributes[\"deployment.environment\"], %q)", sys.env("SENTINEL_ENVIRONMENT")),
    ]
  }
  log_statements {
    context = "resource"
    statements = [
      string.format("set(attributes[\"host.name\"], %q)", sys.env("SENTINEL_HOST_NAME")),
      string.format("set(attributes[\"deployment.environment\"], %q)", sys.env("SENTINEL_ENVIRONMENT")),
    ]
  }
  trace_statements {
    context = "resource"
    statements = [
      string.format("set(attributes[\"host.name\"], %q)", sys.env("SENTINEL_HOST_NAME")),
      string.format("set(attributes[\"deployment.environment\"], %q)", sys.env("SENTINEL_ENVIRONMENT")),
    ]
  }
  output {
    metrics = [otelcol.processor.transform.metric_identity.input]
    logs = [otelcol.processor.attributes.redact.input]
    traces = [otelcol.processor.attributes.redact.input]
  }
}

// Prometheus nao promove todos os atributos de recurso em cada serie OTLP.
otelcol.processor.transform "metric_identity" {
  error_mode = "ignore"
  metric_statements {
    context = "datapoint"
    statements = [
      `delete_key(attributes, "service.name") where resource.attributes["service.name"] != nil`,
      `set(attributes["service_name"], resource.attributes["service.name"]) where resource.attributes["service.name"] != nil`,
      `delete_key(attributes, "host.name")`,
      `set(attributes["host_name"], resource.attributes["host.name"])`,
      `delete_key(attributes, "deployment.environment")`,
      `set(attributes["deployment_environment"], resource.attributes["deployment.environment"])`,
      `delete_key(attributes, "container.name") where resource.attributes["container.name"] != nil`,
      `set(attributes["container_name"], resource.attributes["container.name"]) where resource.attributes["container.name"] != nil`,
      `delete_key(attributes, "container.id") where resource.attributes["container.id"] != nil`,
      `set(attributes["container_id"], resource.attributes["container.id"]) where resource.attributes["container.id"] != nil`,
    ]
  }
  output {
    metrics = [otelcol.processor.batch.applications.input]
  }
}

otelcol.processor.attributes "redact" {
  action {
    key = "http.request.header.authorization"
    action = "delete"
  }
  action {
    key = "http.request.header.cookie"
    action = "delete"
  }
  action {
    key = "user.email"
    action = "delete"
  }
  action {
    key = "http.response.header.set_cookie"
    action = "delete"
  }
  action {
    key = "http.response.header.set-cookie"
    action = "delete"
  }
  action {
    key = "url.full"
    action = "delete"
  }
  action {
    key = "url.query"
    action = "delete"
  }
  action {
    key = "http.url"
    action = "delete"
  }
  action {
    key = "http.target"
    action = "delete"
  }
  output {
    logs = [otelcol.processor.batch.applications.input]
    traces = [otelcol.processor.batch.applications.input]
  }
}

otelcol.processor.batch "applications" {
  output {
    metrics = [otelcol.exporter.otlphttp.sentinel.input]
    logs = [otelcol.exporter.otlphttp.sentinel.input]
    traces = [otelcol.exporter.otlphttp.sentinel.input]
  }
}

otelcol.exporter.otlphttp "sentinel" {
  client {
    endpoint = sys.env("SENTINEL_OTLP_ENDPOINT")
    tls {
      ca_file = "/etc/sentinelops/certs/ca.crt"
      cert_file = "/etc/sentinelops/certs/client.crt"
      key_file = "/etc/sentinelops/certs/client.key"
      server_name = sys.env("SENTINEL_TLS_SERVER_NAME")
      min_version = "1.2"
      reload_interval = "5m"
    }
  }
  retry_on_failure {
    enabled = true
    initial_interval = "5s"
    max_interval = "30s"
    max_elapsed_time = "10m"
  }
  sending_queue {
    enabled = true
    queue_size = 2048
    num_consumers = 4
  }
}
