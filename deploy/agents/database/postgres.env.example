POSTGRES_EXPORTER_ADDRESS=127.0.0.1:9187
POSTGRES_SCRAPE_INTERVAL=30s
POSTGRES_MONITOR_ASSET_ID=postgres-hml-01
POSTGRES_MONITOR_TEAM=database
POSTGRES_MONITOR_ENVIRONMENT=hml
