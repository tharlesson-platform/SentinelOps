+// inheritProcessMatch relaxes only the child's listening-port requirement.
+// Parent history must never bypass the child's identity, container boundary or exclusions.
+func (m *Matcher) inheritProcessMatch(obj *ProcessAttrs, proc *services.ProcessInfo, parent ProcessMatch) *ProcessMatch {
+	if m.isExcluded(obj, proc) {
+		return nil
+	}
+	criteria := make([]services.Selector, 0, len(parent.Criteria))
+	for _, selector := range parent.Criteria {
+		if m.matchProcessSelection(obj, proc, selector, true) {
+			criteria = append(criteria, selector)
+		}
+	}
+	if len(criteria) == 0 {
+		return nil
+	}
+	logCriteria := make([]services.Selector, 0, len(parent.LogEnricherCriteria))
+	for _, selector := range parent.LogEnricherCriteria {
+		if m.matchProcessSelection(obj, proc, selector, true) {
+			logCriteria = append(logCriteria, selector)
+		}
+	}
+	return &ProcessMatch{Criteria: criteria, LogEnricherCriteria: logCriteria, Process: proc}
 }
 
