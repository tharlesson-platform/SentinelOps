+package container
+import("strings";"testing")
+func TestSentinelDockerCgroup(t *testing.T) {
+ id:=strings.Repeat("a",64)
+ for _,entry:=range []string{"13:cpu,cpuacct:/docker/"+id,"0::/docker/"+id,"1:name=systemd:/system.slice/docker-"+id+".scope","0::/k8s.io/"+id,"0::/kubepods/burstable/podabc/"+id} {
+  got,ok:=findCgroup(entry);if !ok||got!=id {t.Fatalf("not recognized: %s: %q %v",entry,got,ok)}
+ }
+ for _,entry:=range []string{"0::/docker/"+id[:12],"0::/docker/"+id+"a","0::/docker/"+strings.Repeat("g",64),"0::/docker/"+id+"/child","0::/", "garbage/docker/"+id} {
+  if got,ok:=findCgroup(entry);ok {t.Fatalf("accepted invalid: %s: %s",entry,got)}
+ }
+}
