+package docker
+import "testing"
+func TestSentinelLogicalService(t *testing.T) {
+ for _,tc:=range []struct{labels map[string]string;want string}{
+  {map[string]string{"com.docker.compose.service":"api","com.docker.swarm.service.name":"stack_api"},"api"},
+  {map[string]string{"com.docker.swarm.service.name":"tqi-data_postgres"},"tqi-data_postgres"},
+  {map[string]string{"com.docker.swarm.task.name":"task.1.random"},""},{nil,""},
+ } {if got:=logicalServiceName(tc.labels);got!=tc.want {t.Fatalf("got %q want %q",got,tc.want)}}
+}
