# syntax=docker/dockerfile:1.7
# Rebuild Caddy from the verified upstream v2.11.4 commit with patched Go
# dependencies. The vendor image is intentionally not used at runtime: its
# embedded Go dependency graph may lag security fixes even when Alpine is current.
FROM --platform=$BUILDPLATFORM golang:1.26.10-bookworm@sha256:23ce71337b726608afb1bc00986e630a05034a87a87ea1fc2cd1ae5cf33387eb AS build

ARG CADDY_SOURCE_REF=e2eee6a7fce366321294c9c2a79f3146891dcbdf
ARG CRYPTO_SOURCE_REF=516f3a2010a5c63c4e71357a3f813e0b9e84d090
ARG CERTIFICATES_SOURCE_REF=6e8ec61405239cf3f37b2bbf260a587b7d2e4e31
ARG TARGETOS
ARG TARGETARCH

COPY deploy/caddy/patches/smallstep-crypto.patch /tmp/smallstep-crypto.patch
COPY deploy/caddy/patches/smallstep-certificates.patch /tmp/smallstep-certificates.patch

RUN test -s /etc/ssl/certs/ca-certificates.crt && command -v git
RUN echo '651f6b95514aee2b3e6b44dd44658eaf8d31b98355fdd0de501ccf3c938ea75c  /tmp/smallstep-crypto.patch' | sha256sum -c - \
    && echo '77735dc48e203427c4523e3fd28b3539431c63c4c72f5090f65adf30fd9b73ef  /tmp/smallstep-certificates.patch' | sha256sum -c - \
    && git init /src/crypto \
    && git -C /src/crypto remote add origin https://github.com/smallstep/crypto.git \
    && git -C /src/crypto fetch --depth=1 origin "$CRYPTO_SOURCE_REF" \
    && git -C /src/crypto checkout --detach FETCH_HEAD \
    && test "$(git -C /src/crypto rev-parse HEAD)" = "$CRYPTO_SOURCE_REF" \
    && git -C /src/crypto apply --check /tmp/smallstep-crypto.patch \
    && git -C /src/crypto apply /tmp/smallstep-crypto.patch \
    && git init /src/certificates \
    && git -C /src/certificates remote add origin https://github.com/smallstep/certificates.git \
    && git -C /src/certificates fetch --depth=1 origin "$CERTIFICATES_SOURCE_REF" \
    && git -C /src/certificates checkout --detach FETCH_HEAD \
    && test "$(git -C /src/certificates rev-parse HEAD)" = "$CERTIFICATES_SOURCE_REF" \
    && git -C /src/certificates apply --check /tmp/smallstep-certificates.patch \
    && git -C /src/certificates apply /tmp/smallstep-certificates.patch
RUN git clone --filter=blob:none --no-checkout https://github.com/caddyserver/caddy.git /src/caddy \
    && git -C /src/caddy checkout --detach "$CADDY_SOURCE_REF" \
    && test "$(git -C /src/caddy rev-parse HEAD)" = "$CADDY_SOURCE_REF"

WORKDIR /src/caddy
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    go mod edit -replace=go.step.sm/crypto=/src/crypto \
    && go mod edit -replace=github.com/smallstep/certificates=/src/certificates \
    && go get golang.org/x/crypto@v0.58.0 golang.org/x/net@v0.61.0 golang.org/x/text@v0.43.0 google.golang.org/grpc@v1.84.0 github.com/go-jose/go-jose/v4@v4.1.6 github.com/klauspost/compress@v1.18.7 \
    && go mod tidy \
    && CGO_ENABLED=0 go test -mod=mod -p 2 -timeout 180s go.step.sm/crypto/jose github.com/smallstep/certificates/authority/provisioner github.com/smallstep/certificates/cas/stepcas github.com/smallstep/certificates/acme github.com/go-jose/go-jose/v4/... \
    && CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -p 2 -trimpath -ldflags='-s -w -buildid=' -o /out/caddy ./cmd/caddy

FROM alpine:3.23.5@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40

RUN apk upgrade --no-cache \
    && apk add --no-cache \
      ca-certificates \
      libcrypto3 \
      libssl3 \
      musl \
      tzdata \
      zlib \
    && addgroup -S -g 10001 caddy \
    && adduser -S -D -H -u 10001 -G caddy caddy

COPY --from=build --chown=caddy:caddy /out/caddy /usr/bin/caddy

USER 10001:10001
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
