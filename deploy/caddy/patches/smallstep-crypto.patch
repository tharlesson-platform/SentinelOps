+// hmacKeySize returns the minimum size in bytes of the key for the given HMAC
+// algorithm, or 0 if alg is not an HMAC algorithm.
+func hmacKeySize(alg string) int {
+	switch alg {
+	case HS256:
+		return 32
+	case HS384:
+		return 48
+	case HS512:
+		return 64
+	default:
+		return 0
+	}
+}
+
+// aesKeySize returns the exact size in bytes of the key for the given AES key
+// wrap algorithm, or 0 if alg is not an AES key wrap algorithm.
+func aesKeySize(alg string) int {
+	switch KeyAlgorithm(alg) {
+	case A128KW, A128GCMKW:
+		return 16
+	case A192KW, A192GCMKW:
+		return 24
+	case A256KW, A256GCMKW:
+		return 32
+	default:
+		return 0
+	}
+}
+
+// defaultOctSize returns the size in bytes of the oct key generated by
+// default for the given algorithm.
+func defaultOctSize(alg string) int {
+	if n := hmacKeySize(alg); n > 0 {
+		return n
+	}
+	if n := aesKeySize(alg); n > 0 {
+		return n
+	}
+	return DefaultOctSize
+}
