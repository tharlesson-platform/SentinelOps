new file mode 100644
index 0000000..24bcc72
--- /dev/null
+++ b/internal/compatfixtures/main.go
@@ -0,0 +1,43 @@
+// Command compatfixtures rebuilds public upstream test data after the JOSE v4
+// Ed25519 consistency fix. It is used only while preparing the build test tree.
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+
+	"go.step.sm/crypto/jose"
+)
+
+func main() {
+	const plain = "jose/testdata/okp.priv.json"
+	const encrypted = "jose/testdata/okp.enc.priv.json"
+	key, err := jose.ReadKey(plain)
+	if err != nil {
+		panic(err)
+	}
+	// This is the upstream public fixture passphrase, never an operational secret.
+	fixture, err := jose.EncryptJWK(key, []byte("password"))
+	if err != nil {
+		panic(err)
+	}
+	if err := os.WriteFile(encrypted, []byte(fixture.FullSerialize()+"\n"), 0600); err != nil {
+		panic(err)
+	}
+	restored, err := jose.ReadKey(encrypted, jose.WithPassword([]byte("password")))
+	if err != nil {
+		panic(err)
+	}
+	expected, err := json.Marshal(key)
+	if err != nil {
+		panic(err)
+	}
+	actual, err := json.Marshal(restored)
+	if err != nil {
+		panic(err)
+	}
+	if !bytes.Equal(expected, actual) {
+		panic("generated fixture failed cryptographic round trip")
+	}
+}
diff --git a/jose/compatibility_test.go b/jose/compatibility_test.go
new file mode 100644
index 0000000..9c2e957
--- /dev/null
+++ b/jose/compatibility_test.go
@@ -0,0 +1,188 @@
+package jose
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/base64"
+	"encoding/json"
+	"go.step.sm/crypto/x25519"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestLegacyBuilderUsesCorrectedV4JWT(t *testing.T) {
+	key := bytes.Repeat([]byte{0x42}, 32)
+	signer, err := NewSigner(SigningKey{Algorithm: HS256, Key: key}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	builder := Signed(signer).Claims(Claims{
+		Issuer: "issuer", Audience: Audience{"expected"},
+		Expiry: NewNumericDate(now.Add(time.Minute)),
+	}).Claims(map[string]interface{}{"tenant": "synthetic"})
+	legacy, err := builder.CompactSerialize()
+	if err != nil {
+		t.Fatal(err)
+	}
+	modern, err := builder.Serialize()
+	if err != nil || modern != legacy {
+		t.Fatalf("compact JWT changed: %v", err)
+	}
+	parsed, err := ParseSigned(legacy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var claims Claims
+	var extra struct {
+		Tenant string `json:"tenant"`
+	}
+	if err := parsed.Claims(key, &claims, &extra); err != nil {
+		t.Fatal(err)
+	}
+	if extra.Tenant != "synthetic" {
+		t.Fatal("chained claims were lost")
+	}
+	if err := claims.Validate(Expected{Issuer: "issuer", AnyAudience: Audience{"expected"}, Time: now}); err != nil {
+		t.Fatal(err)
+	}
+	if err := claims.Validate(Expected{Issuer: "issuer", AnyAudience: Audience{"other"}, Time: now}); err == nil {
+		t.Fatal("wrong audience accepted")
+	}
+	if err := parsed.Claims(bytes.Repeat([]byte{0x43}, 32), &claims); err == nil {
+		t.Fatal("wrong signing key accepted")
+	}
+	if _, err := builder.Token(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestKnownX25519OpaqueAdapter(t *testing.T) {
+	pub, priv, err := x25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	opts := new(SignerOptions).WithType("JWT").WithHeader(HeaderKey("nebula"), "synthetic-certificate")
+	signer, err := NewSigner(SigningKey{Algorithm: XEdDSA, Key: priv}, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := Signed(signer).Claims(Claims{Issuer: "issuer", Audience: Audience{"expected"}}).Serialize()
+	if err != nil {
+		t.Fatal(err)
+	}
+	token, err := ParseSigned(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if token.Headers[0].Algorithm != string(XEdDSA) || token.Headers[0].ExtraHeaders[HeaderKey("nebula")] != "synthetic-certificate" {
+		t.Fatal("signing metadata changed")
+	}
+	var claims Claims
+	if err := Verify(token, pub, &claims); err != nil {
+		t.Fatal(err)
+	}
+	wrong, _, err := x25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := Verify(token, wrong, &claims); err == nil {
+		t.Fatal("wrong key accepted")
+	}
+	parts := strings.Split(raw, ".")
+	parts[1] = base64.RawURLEncoding.EncodeToString([]byte(`{"iss":"altered"}`))
+	altered, err := ParseSigned(strings.Join(parts, "."))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := Verify(altered, pub, &claims); err == nil {
+		t.Fatal("altered payload accepted")
+	}
+	for _, invalid := range []SigningKey{{Algorithm: HS256, Key: priv}, {Algorithm: XEdDSA, Key: x25519.PrivateKey(nil)}, {Algorithm: XEdDSA, Key: x25519.PrivateKey(make([]byte, 31))}, {Algorithm: XEdDSA, Key: x25519.PrivateKey(make([]byte, 33))}} {
+		if _, err := NewSigner(invalid, nil); err == nil {
+			t.Fatal("invalid X25519 key or algorithm accepted")
+		}
+	}
+	for _, forbidden := range []*SignerOptions{{EmbedJWK: true}, new(SignerOptions).WithHeader(HeaderKey("jwk"), nil)} {
+		if _, err := NewSigner(SigningKey{Algorithm: XEdDSA, Key: priv}, forbidden); err == nil {
+			t.Fatal("unsupported JWK embedding accepted")
+		}
+	}
+}
+
+type privatePublicSigner struct {
+	OpaqueSigner
+	key *JSONWebKey
+}
+
+func (s privatePublicSigner) Public() *JSONWebKey { return s.key }
+
+func TestGenericOpaquePrivateJWKStillRejected(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	opaque := privatePublicSigner{OpaqueSigner: NewOpaqueSigner(key), key: &JSONWebKey{Key: key}}
+	if _, err := NewSigner(SigningKey{Algorithm: RS256, Key: opaque}, nil); err == nil {
+		t.Fatal("generic opaque signer private JWK accepted")
+	}
+}
+
+func TestInconsistentEd25519FixtureRejected(t *testing.T) {
+	bad, err := os.ReadFile("testdata/okp.mismatched.priv.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var key JSONWebKey
+	if err := json.Unmarshal(bad, &key); err == nil || !strings.Contains(err.Error(), "x does not match d") {
+		t.Fatal("inconsistent private/public JWK accepted")
+	}
+	if _, err := ParseKey(bad); err == nil {
+		t.Fatal("inconsistent key accepted by wrapper")
+	}
+	encrypted, err := Encrypt(bad, WithPassword([]byte("password")))
+	if err != nil {
+		t.Fatal(err)
+	}
+	decrypted, err := Decrypt([]byte(encrypted.FullSerialize()), WithPassword([]byte("password")))
+	if err != nil || !bytes.Equal(decrypted, bad) {
+		t.Fatal("negative encrypted fixture did not round-trip")
+	}
+	if _, err := ParseKey([]byte(encrypted.FullSerialize()), WithPassword([]byte("password"))); err == nil {
+		t.Fatal("inconsistent encrypted key accepted")
+	}
+	fixed, err := os.ReadFile("testdata/okp.priv.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var oldFields, newFields map[string]interface{}
+	if err := json.Unmarshal(bad, &oldFields); err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(fixed, &newFields); err != nil {
+		t.Fatal(err)
+	}
+	if oldFields["d"] != newFields["d"] || oldFields["x"] == newFields["x"] {
+		t.Fatal("fixture private seed changed or public mismatch not repaired")
+	}
+}
+
+func TestLegacyBuilderPreservesSerializationErrors(t *testing.T) {
+	signer, err := NewSigner(SigningKey{Algorithm: HS256, Key: bytes.Repeat([]byte{0x42}, 32)}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	builder := Signed(signer).Claims(make(chan int))
+	if _, err := builder.CompactSerialize(); err == nil {
+		t.Fatal("legacy API swallowed invalid claims")
+	}
+	if _, err := builder.Serialize(); err == nil {
+		t.Fatal("new API swallowed invalid claims")
+	}
+	if _, err := builder.Token(); err == nil {
+		t.Fatal("token API swallowed invalid claims")
+	}
+}
