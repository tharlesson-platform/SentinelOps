{
	admin off
	servers {
		max_header_size 64KB
		timeouts {
			read_body 30s
			read_header 10s
			idle 2m
		}
	}
}

(collector_mtls) {
	tls /certs/server.crt /certs/server.key {
		protocols tls1.2 tls1.3
		client_auth {
			mode require_and_verify
			trust_pool file /certs/client-ca.crt
		}
	}
}

https://:8443 {
	import collector_mtls
	request_body {
		max_size 16MB
	}
	@prometheus {
		path /api/v1/write
		vars_regexp tenant_uri {http.request.tls.client.san.uris.0} ^spiffe://sentinelops/organizations/([A-Za-z0-9][A-Za-z0-9._-]{1,62})/collectors/([A-Za-z0-9][A-Za-z0-9._-]{1,62})$
	}
	handle @prometheus {
		reverse_proxy prometheus:9090 {
			header_up X-Scope-OrgID {re.tenant_uri.1}
		}
	}

	@loki {
		path /loki/api/v1/push
		vars_regexp tenant_uri {http.request.tls.client.san.uris.0} ^spiffe://sentinelops/organizations/([A-Za-z0-9][A-Za-z0-9._-]{1,62})/collectors/([A-Za-z0-9][A-Za-z0-9._-]{1,62})$
	}
	handle @loki {
		reverse_proxy loki:3100 {
			header_up X-Scope-OrgID {re.tenant_uri.1}
		}
	}

	@otlp {
		path /v1/metrics /v1/logs /v1/traces
		vars_regexp tenant_uri {http.request.tls.client.san.uris.0} ^spiffe://sentinelops/organizations/([A-Za-z0-9][A-Za-z0-9._-]{1,62})/collectors/([A-Za-z0-9][A-Za-z0-9._-]{1,62})$
	}
	handle @otlp {
		reverse_proxy alloy:4318 {
			header_up tenant_id {re.tenant_uri.1}
		}
	}

	@agents {
		path /api/v1/agents/register /api/v1/agents/*/heartbeat /api/v1/agents/*/inventory-reconcile
		vars_regexp tenant_uri {http.request.tls.client.san.uris.0} ^spiffe://sentinelops/organizations/([A-Za-z0-9][A-Za-z0-9._-]{1,62})/collectors/([A-Za-z0-9][A-Za-z0-9._-]{1,62})$
	}
	handle @agents {
		reverse_proxy api:8080 {
			header_up X-Sentinel-Client-Cert-Fingerprint {tls_client_fingerprint}
			header_up X-Sentinel-Client-Organization {re.tenant_uri.1}
			header_up X-Sentinel-Client-Name {re.tenant_uri.2}
			header_up X-Sentinel-MTLS-Proxy-Authorization {env.MTLS_PROXY_SHARED_SECRET}
		}
	}

	respond 404
}

# Somente leitores de telemetria do Control Plane possuem estes SANs. Eles
# fornecem a organização a partir da identidade autenticada ou do workflow;
# o gateway remove o cabeçalho de entrada e injeta X-Scope-OrgID no upstream.
https://:8444 {
	import collector_mtls
	@discovery {
	  method GET
	  path_regexp discovery_path ^/prometheus/api/v1/(metadata|labels|series|targets|rules|label/[a-zA-Z_][a-zA-Z0-9_]*/values)$
	  header_regexp discovery_tenant X-Sentinel-Organization ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$
	  expression `{http.request.header.X-Sentinel-Organization}.matches("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")`
	  vars_regexp discovery_api {http.request.tls.client.san.uris.0} ^spiffe://sentinelops/workloads/control-plane-api$
	}
	handle @discovery {
	  uri strip_prefix /prometheus
	  reverse_proxy prometheus:9090 {
	    header_up X-Scope-OrgID {http.request.header.X-Sentinel-Organization}
	    header_up -X-Sentinel-Organization
	  }
	}
	@loki_discovery {
	  method GET
	  path_regexp loki_discovery_path ^/loki/loki/api/v1/(query|label/[a-zA-Z_][a-zA-Z0-9_]*/values)$
	  header_regexp loki_discovery_tenant X-Sentinel-Organization ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$
	  expression `{http.request.header.X-Sentinel-Organization}.matches("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")`
	  vars_regexp loki_discovery_api {http.request.tls.client.san.uris.0} ^spiffe://sentinelops/workloads/control-plane-api$
	}
	handle @loki_discovery {
	  uri strip_prefix /loki
	  reverse_proxy loki:3100 {
	    header_up X-Scope-OrgID {http.request.header.X-Sentinel-Organization}
	    header_up -X-Sentinel-Organization
	  }
	}
	@profile_queries {
	  method POST
	  path_regexp profile_queries_path ^/pyroscope/querier[.]v1[.]QuerierService/(ProfileTypes|LabelNames|LabelValues|SelectMergeStacktraces)$
	  header_regexp profile_queries_tenant X-Sentinel-Organization ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$
	  expression `{http.request.header.X-Sentinel-Organization}.matches("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")`
	  vars_regexp profile_queries_api {http.request.tls.client.san.uris.0} ^spiffe://sentinelops/workloads/control-plane-api$
	}
	handle @profile_queries {
	  uri strip_prefix /pyroscope
	  reverse_proxy pyroscope:4040 {
	    header_up X-Scope-OrgID {http.request.header.X-Sentinel-Organization}
	    header_up -X-Sentinel-Organization
	  }
	}
	@prometheus {
		path /prometheus/api/v1/query /prometheus/api/v1/query_range
		header X-Sentinel-Organization *
		vars_regexp worker_uri {http.request.tls.client.san.uris.0} ^spiffe://sentinelops/workloads/(release-validator|control-plane-api)$
	}
	handle @prometheus {
		uri strip_prefix /prometheus
		reverse_proxy prometheus:9090 {
			header_up X-Scope-OrgID {http.request.header.X-Sentinel-Organization}
			header_up -X-Sentinel-Organization
		}
	}
	@loki {
		path /loki/loki/api/v1/query_range
		header X-Sentinel-Organization *
		vars_regexp worker_uri {http.request.tls.client.san.uris.0} ^spiffe://sentinelops/workloads/(release-validator|control-plane-api)$
	}
	handle @loki {
		uri strip_prefix /loki
		reverse_proxy loki:3100 {
			header_up X-Scope-OrgID {http.request.header.X-Sentinel-Organization}
			header_up -X-Sentinel-Organization
		}
	}
	@tempo {
		path /tempo/api/search
		header X-Sentinel-Organization *
		vars_regexp worker_uri {http.request.tls.client.san.uris.0} ^spiffe://sentinelops/workloads/(release-validator|control-plane-api)$
	}
	handle @tempo {
		uri strip_prefix /tempo
		reverse_proxy tempo:3200 {
			header_up X-Scope-OrgID {http.request.header.X-Sentinel-Organization}
			header_up -X-Sentinel-Organization
		}
	}
	respond 404
}

https://:4317 {
	import collector_mtls
	@tenant vars_regexp tenant_uri {http.request.tls.client.san.uris.0} ^spiffe://sentinelops/organizations/([A-Za-z0-9][A-Za-z0-9._-]{1,62})/collectors/([A-Za-z0-9][A-Za-z0-9._-]{1,62})$
	handle @tenant {
		reverse_proxy h2c://alloy:4317 {
			header_up tenant_id {re.tenant_uri.1}
		}
	}
	respond 403
}
