otelcol.receiver.otlp "default" {
  grpc {
    endpoint         = "0.0.0.0:4317"
    include_metadata = true
  }
  http {
    endpoint         = "0.0.0.0:4318"
    include_metadata = true
  }
  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.attributes.redact.input]
    traces  = [otelcol.processor.tail_sampling.default.input]
  }
}

otelcol.processor.attributes "redact" {
  action {
    key    = "http.request.header.authorization"
    action = "delete"
  }
  action {
    key    = "http.request.header.cookie"
    action = "delete"
  }
  action {
    key    = "user.email"
    action = "delete"
  }
  output {
    logs = [otelcol.processor.batch.logs.input]
  }
}

otelcol.processor.tail_sampling "default" {
  decision_wait = "5s"
  num_traces    = 50000
  policy {
    name = "errors"
    type = "status_code"
    status_code {
      status_codes = ["ERROR"]
    }
  }
  policy {
    name = "synthetic"
    type = "string_attribute"
    string_attribute {
      key                    = "http.request.header.x_synthetic_test"
      values                 = ["sentinelops"]
      enabled_regex_matching = true
    }
  }
  policy {
    name = "baseline"
    type = "probabilistic"
    probabilistic {
      sampling_percentage = 20
    }
  }
  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "default" {
  metadata_keys = ["tenant_id"]
  output {
    metrics = [otelcol.exporter.otlphttp.prometheus.input]
  }
}
otelcol.processor.batch "logs" {
  metadata_keys = ["tenant_id"]
  output {
    logs = [otelcol.exporter.otlphttp.loki.input]
  }
}
otelcol.processor.batch "traces" {
  metadata_keys = ["tenant_id"]
  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.auth.headers "tenant" {
  header {
    key          = "X-Scope-OrgID"
    from_context = "tenant_id"
  }
}

otelcol.exporter.otlphttp "prometheus" {
  client {
    endpoint = "http://prometheus:9090/api/v1/otlp"
    auth     = otelcol.auth.headers.tenant.handler
  }
}
otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
    auth     = otelcol.auth.headers.tenant.handler
  }
}
otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
    auth     = otelcol.auth.headers.tenant.handler
  }
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

pyroscope.write "local" {
  endpoint {
    url = "http://pyroscope:4040"
  }
}
