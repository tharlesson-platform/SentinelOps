# syntax=docker/dockerfile:1.7

# Generate static UI assets natively; the later Go/CGO build keeps its target.
FROM --platform=$BUILDPLATFORM node@sha256:0353e48e0e8a993db87b720c242f54b207059d1bcc0106534896e8a11054c837 AS source-ui
ARG ALLOY_SOURCE_REF=6012ec4ac6a541ade720777ecec2f2b02b496def
RUN git clone --filter=blob:none --no-checkout https://github.com/grafana/alloy.git /src/alloy \
    && git -C /src/alloy checkout --detach "$ALLOY_SOURCE_REF" \
    && test "$(git -C /src/alloy rev-parse HEAD)" = "$ALLOY_SOURCE_REF"
WORKDIR /src/alloy/internal/web/ui
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm ci --ignore-scripts --no-audit --no-fund \
    && npm run build

# This stage exports patched sources and go.mod, never target binaries.
FROM --platform=$BUILDPLATFORM golang:1.26.9-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c AS moby-backport
ARG MOBY_LEGACY_REF=89c5e8fd66634b6128fc4c0e6f1236e2540e46e0
ENV PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
RUN git clone --filter=blob:none --no-checkout https://github.com/moby/moby.git /src/docker \
    && git -C /src/docker checkout --detach "$MOBY_LEGACY_REF" \
    && test "$(git -C /src/docker rev-parse HEAD)" = "$MOBY_LEGACY_REF"
COPY deploy/alloy/patches/moby-cve-2026-34040.patch /tmp/moby-cve-2026-34040.patch
RUN echo "2445c60b47a5f43b0b9ed5d25f19ae351fc63ab932a52f460d2ee23d4a893e37  /tmp/moby-cve-2026-34040.patch" | sha256sum -c - \
    && git -C /src/docker apply --check /tmp/moby-cve-2026-34040.patch \
    && git -C /src/docker apply /tmp/moby-cve-2026-34040.patch \
    && cd /src/docker \
    && go mod init github.com/docker/docker \
    && grep -Fq 'request body too large for authorization plugin' pkg/authorization/authz.go
COPY deploy/alloy/patches/moby-cve-2026-34040-tests.patch /tmp/moby-cve-2026-34040-tests.patch
RUN echo "c6fc52fa701f5c8e5a9770a3f2ec7bad3bfedf799a7b5cfe5fe184a8037c4df6  /tmp/moby-cve-2026-34040-tests.patch" | sha256sum -c - \
    && git -C /src/docker apply --check /tmp/moby-cve-2026-34040-tests.patch \
    && git -C /src/docker apply /tmp/moby-cve-2026-34040-tests.patch \
    && cd /src/docker \
    && go env -json GOOS GOARCH CGO_ENABLED GOEXPERIMENT GOVERSION > /src/docker/.sentinel-authz-platform.json \
    && (go test -modfile=vendor.mod -mod=vendor -count=1 -timeout=2m -json ./pkg/authorization > /src/docker/.sentinel-authz-tests.json || { cat /src/docker/.sentinel-authz-tests.json; exit 1; }) \
    && cat /src/docker/.sentinel-authz-tests.json

FROM golang:1.26.9-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c AS patched-go

FROM grafana/alloy-build-image@sha256:4371598809230ffd7611367ba0dcb92bbc8b74bda88471293e5d478b48a0d186 AS build
ARG ALLOY_SOURCE_REF=6012ec4ac6a541ade720777ecec2f2b02b496def
ARG ALLOY_VERSION=v1.18.1-sentinel.2
COPY --from=patched-go /usr/local/go /usr/local/go
COPY --from=source-ui /src/alloy /src/alloy
COPY --from=moby-backport /src/docker /src/docker
WORKDIR /src/alloy
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go mod edit -replace github.com/docker/docker=/src/docker \
    && go get github.com/apache/thrift@v0.24.0 \
           github.com/go-git/go-git/v5@v5.19.2 \
           golang.org/x/mod@v0.41.0 \
           golang.org/x/net@v0.60.0 \
           google.golang.org/grpc@v1.83.2 \
    && go get go.opentelemetry.io/otel/sdk@v1.45.0 \
              go.opentelemetry.io/otel/exporters/otlp/otlptrace@v1.45.0 \
              go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc@v1.45.0 \
              go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracehttp@v1.45.0 \
              go.opentelemetry.io/otel/sdk/log@v0.21.0 \
              go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc@v0.21.0 \
              go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploghttp@v0.21.0 \
              go.opentelemetry.io/otel/exporters/stdout/stdoutlog@v0.21.0 \
              go.opentelemetry.io/contrib/bridges/otelzap@v0.20.0 \
    && go get github.com/grafana/snowflake-prometheus-exporter@v0.0.0-20261007132928-5be547ff96d8 \
              github.com/burningalchemist/sql_exporter@v0.0.0-20260318125227-7186d9947bc1 \
              github.com/snowflakedb/gosnowflake/v2@v2.2.0 \
    && go mod tidy \
    && go mod edit -require=github.com/docker/docker@v28.5.2+incompatible \
    && go mod edit -modfile=collector/go.mod -replace github.com/docker/docker=/src/docker \
    && go mod edit -modfile=collector/go.mod -require=github.com/docker/docker@v28.5.2+incompatible \
    && go mod edit -modfile=collector/go.mod -require=google.golang.org/grpc@v1.83.2 \
    && sed -i '\#  - github.com/grafana/alloy/syntax => ../syntax#a\  - github.com/docker/docker => /src/docker' collector/builder-config.yaml
RUN --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    CGO_ENABLED=1 go test -count=1 -timeout=5m \
      github.com/grafana/snowflake-prometheus-exporter/collector \
      github.com/burningalchemist/sql_exporter \
      github.com/burningalchemist/sql_exporter/config \
      ./internal/static/integrations/mssql \
      ./internal/static/integrations/snowflake_exporter \
      ./internal/component/prometheus/exporter/mssql \
      ./internal/component/prometheus/exporter/snowflake
RUN --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    test "$(go list -m -f '{{.Version}}' github.com/snowflakedb/gosnowflake/v2)" = v2.2.0 \
    && snowflake_source="$(go list -m -f '{{.Dir}}' github.com/snowflakedb/gosnowflake/v2)" \
    && test -n "$snowflake_source" \
    && cd "$snowflake_source" \
    && go mod download \
    && GOPROXY=off GOTOOLCHAIN=local CGO_ENABLED=1 go test -mod=readonly -count=1 -timeout=5m ./internal/config -run '^(TestParseDSN|TestDSN|TestAccountIdentifierRejectsInvalidCharacters)$' \
    && GOPROXY=off GOTOOLCHAIN=local CGO_ENABLED=1 go test -mod=readonly -count=1 -timeout=5m ./internal/logger -run '^(TestSecretMaskingLogger|TestSecretsDetectorMasksSSECKeyAndSigV4Params|TestSecretsDetectorMasksPresignedSignature|TestSecretsDetectorMasksSnowflakeSessionToken)$'
RUN --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    RELEASE_BUILD=1 VERSION="$ALLOY_VERSION" GO_TAGS="netgo embedalloyui promtail_journal_enabled" SKIP_UI_BUILD=1 make alloy \
    && ./build/alloy --version \
    && mkdir -p ./build/security \
    && go version -m ./build/alloy > ./build/security/build-info.txt \
    && grep -F 'go1.26.9' ./build/security/build-info.txt \
    && build_target_arch="$(awk '$1 == "build" && $2 ~ /^GOARCH=/ { sub(/^GOARCH=/, "", $2); print $2 }' ./build/security/build-info.txt)" \
    && test -n "$build_target_arch" \
    && test "$build_target_arch" = "$(go env GOARCH)" \
    && grep -Eq '^[[:space:]]+build[[:space:]]+GOOS=linux$' ./build/security/build-info.txt \
    && grep -Eq '^[[:space:]]+build[[:space:]]+CGO_ENABLED=1$' ./build/security/build-info.txt \
    && CGO_ENABLED=1 GOOS=linux GOARCH="$build_target_arch" GOEXPERIMENT= go env -json GOOS GOARCH CGO_ENABLED GOEXPERIMENT GOVERSION > ./build/security/go-env.json \
    && (cd collector && CGO_ENABLED=1 GOOS=linux GOARCH="$build_target_arch" GOEXPERIMENT= go list -mod=readonly -deps -json -tags 'gore2regex netgo embedalloyui promtail_journal_enabled' .) > ./build/security/packages.json \
    && (cd collector && CGO_ENABLED=1 GOOS=linux GOARCH="$build_target_arch" GOEXPERIMENT= go list -mod=readonly -m -json all) > ./build/security/modules.json \
    && git -C /src/docker rev-parse HEAD > ./build/security/moby-base-sha.txt \
    && cp /src/docker/.sentinel-authz-tests.json ./build/security/moby-authz-tests.json \
    && cp /src/docker/.sentinel-authz-platform.json ./build/security/moby-authz-platform.json \
    && sha256sum ./build/alloy /src/docker/pkg/authorization/authz.go /src/docker/pkg/authorization/authz_unix_test.go > ./build/security/source-and-binary-sha256.txt

FROM mirror.gcr.io/grafana/alloy@sha256:0f4434c92b3e6cdac38bb129b344e1790c246f7b6e2eaffcc16a5fa363240e33
ARG ALLOY_SOURCE_REF=6012ec4ac6a541ade720777ecec2f2b02b496def
LABEL org.opencontainers.image.source="https://github.com/grafana/alloy" \
      org.opencontainers.image.revision="$ALLOY_SOURCE_REF" \
      org.opencontainers.image.version="v1.18.1-sentinel.2" \
      io.sentinelops.moby.backport="v28.5.2+e89edb19ad7de0407a5d31e3111cb01aa10b5a38" \
      org.opencontainers.image.description="SentinelOps rebuild of Alloy v1.18.1 with patched Go, Moby and gRPC dependencies"
COPY --from=build --chown=473:473 /src/alloy/build/alloy /bin/alloy
COPY --from=build /src/alloy/build/security /usr/share/sentinelops/alloy-security
USER root
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends --only-upgrade libssl3t64 openssl \
    && rm -rf /var/lib/apt/lists/*
USER 473:473
