POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
JWT_SECRET=__JWT_SECRET__
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=__LOCAL_ADMIN_PASSWORD__
LOCAL_ADMIN_PASSWORD_HASH='__LOCAL_ADMIN_PASSWORD_HASH__'
AGENT_BOOTSTRAP_TOKEN=__AGENT_BOOTSTRAP_TOKEN__
MTLS_PROXY_SHARED_SECRET=__MTLS_PROXY_SHARED_SECRET__
WEBHOOK_HMAC_SECRET=__WEBHOOK_HMAC_SECRET__
OIDC_API_AUDIENCE=sentinelops-api
OIDC_REQUIRED_SCOPE=sentinelops.api
# Quota global inicial por organização autenticada; owner: Plataforma/SRE.
# Ajuste somente com análise de impacto, métrica de rejeição e janela aprovada.
TENANT_REQUESTS_PER_MINUTE=600
# Teto adicional para cada consulta de catálogo por organização. Inclui MCP,
# pois o servidor MCP usa a mesma API autenticada e não confia em headers do cliente.
CATALOG_QUERIES_PER_MINUTE=120
# JSON secret injected by the secret manager; route specs reference keys, never URLs.
NOTIFICATION_WEBHOOK_URLS={}
NOTIFICATION_ALLOWED_HOSTS=
MINIO_ROOT_USER=__MINIO_ROOT_USER__
MINIO_ROOT_PASSWORD=__MINIO_ROOT_PASSWORD__
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GRAFANA_ADMIN_PASSWORD__
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=__KEYCLOAK_ADMIN_PASSWORD__
SENTINEL_WEB_BIND_ADDRESS=127.0.0.1
SENTINEL_WEB_PORT=3000
SENTINEL_GRAFANA_BIND_ADDRESS=127.0.0.1
SENTINEL_KEYCLOAK_BIND_ADDRESS=127.0.0.1
SENTINEL_TEMPORAL_UI_BIND_ADDRESS=127.0.0.1
SENTINEL_TEMPO_BIND_ADDRESS=127.0.0.1
SENTINEL_PYROSCOPE_BIND_ADDRESS=127.0.0.1
